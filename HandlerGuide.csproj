<!-- ============================================================================
     HandlerGuide.csproj — 项目文件（net8.0-windows / WPF）
     项目：HandlerGuide（EXCEED9000 高速分选机控制软件界面复刻 · 苹果风格）
     说明：无 .NET 8 运行时时靠 RollForward=Major 在 .NET 10 运行；
           手册 .docx 设为 CopyToOutputDirectory 供运行时加载。
     ============================================================================ -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- 视图模型里大量可选参数使用 null 默认值，关闭对应的可空性提示噪音 -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8601;CS8603;CS8604;CS8600;CS8602;CS8629;CS8605;CS8765;CS8612;CS8767;CS8622</NoWarn>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HandlerGuide</AssemblyName>
    <RootNamespace>HandlerGuide</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- 把用户手册随程序一起发布，运行时直接读取复刻页面 -->
    <!-- 雷赛 DMC-E 总线卡 / DMC 脉冲卡原生驱动（LTDMC.dll）。
         必须放在 exe 同级目录：DllImport("LTDMC.dll") 的默认搜索顺序里
         只有应用程序目录与 PATH，放在 native\ 子目录里是找不到的
         （曾因此一直报「LTDMC.dll 缺失」，真卡永远连不上）。
         本机未插卡时 dmc_board_init 返回 0，MotionManager 自动降级为内置仿真卡。 -->
    <None Include="native\LTDMC.dll" Link="LTDMC.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="image\NG.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="image\OK.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 三温标准机 3D 整机渲染图（1920×1050 JPEG）。
         注意：这张图**已经不被任何页面引用了** —— 它原来是「3D整机图」页签的
         底图（贴一张斜二测渲染图 + 盖几个平行四边形，假三维），之后那版曾改成
         ViewModels/Layout3D.cs 自算三维；本版按用户要求**整个撤掉 3D 仿真**，
         页签只剩「2D平面图 / 整机俯视图」，Layout3D.cs 也已删除。
         要找回那份 3D 代码：git show 68ec276:ViewModels/Layout3D.cs
         这里保留拷贝只是为了让旧版本对比时文件还在；哪天确认不再需要，
         把下面这个 <None> 条目和 image/handler_3d.jpg 一起删掉即可。 -->
    <None Update="image\handler_3d.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 三温标准机 整机俯视图（空机台、无料盘），用于「模块平面仿真」页的俯视图标签：
          1696×1376 JPEG，运行时由 LayoutPages.BuildLayoutCanvasTop() 以
          pack://siteoforigin:,,,/image/handler_top.jpg 加载为画布底图，
          再由代码按真机量测坐标把 14 个料盘（上排 6 深盘 / 中排 5 深盘 / 左下 3 绿盘）
          画在底图上并做走料动画。 -->
    <None Update="image\handler_top.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 整机俯视图的「修补底图」：把三根手臂（料盘搬运臂 / 下料臂 / 上料臂）以及两根蓝色
          横梁从照片里擦掉之后的版本（1696×1376）。「模块平面仿真」页优先加载它，手臂/横梁
          才能单独抠出来走位而不留重影；擦除处用「同一批 y 行上的干净列」或梁外侧确认为纯
          底板的那一行（下料梁取 y=812、上料梁取 y=1292，均做中位滤波 + 中位钳位）按行补平。 -->
    <None Update="image\handler_top_clean.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 料盘搬运臂「抠图」：从 handler_top.jpg 的照片框 (1166,424)-(1342,810)
         抠出的 RGBA 透明底图元（176×386），画布上逐帧只改 X —— 真机上该模组
         吊在横导轨下，只有 X 一个自由度（温启志 18719361399）。 -->
    <None Update="image\tray_arm.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 下料手臂「抠图」：照片框 (334,750)-(524,942)，RGBA 190×192。
         含红色滑座 + 上下 4 根蓝导杆 + 白色法兰 + 左下白夹头，整块作为一个图元，
         画布上逐帧只改 X（红色滑座沿横梁走 = 机器 X）。温启志 18719361399 -->
    <None Update="image\unload_arm_head.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 上料手臂「抠图」：照片框 (1282,1144)-(1424,1318)，RGBA 142×174，
         与下料臂同一套做法（红色滑座沿横梁走 = 机器 X）。温启志 18719361399 -->
    <None Update="image\load_arm_head.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 下料侧蓝色横梁「抠图」：照片框 (142,820)-(796,880)，RGBA 654×60。
         含深蓝导轨 + 上下黄描边 + 两端黄色端头支架 + 两个绿滑块；红滑座那一段用
         「同一行的干净导轨列」补平成导轨。整根梁做 Y（俯视图上下）平移。 -->
    <None Update="image\beam_down.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 上料侧蓝色横梁「抠图」：照片框 (1141,1201)-(1555,1263)，RGBA 414×62。
         与下料梁同一套做法，整根梁做 Y 平移。温启志 18719361399 -->
    <None Update="image\beam_up.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 下料侧「红色滑座」抠图：照片框 (80,664)-(180,1004)，RGBA 101×341。
         红滑座 + 下方白色支架，随下料横梁一起沿竖直导轨升降；底图同一块已用
         上料侧同一 y 行的导轨列补平。温启志 18719361399 -->
    <None Update="image\unload_carriage.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 上料侧「红色滑座」抠图：照片框 (1519,1042)-(1621,1318)，RGBA 103×277。
         与下料侧同一套做法，随上料横梁升降。温启志 18719361399 -->
    <None Update="image\load_carriage.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 工艺流程脚本（Lua）：LuaFlowHost.ScriptDir = <输出目录>/Scripts。
         原来只放在源码目录里、没拷到输出目录，仿真页的流程列表永远是 0 条。 -->
    <Content Include="Scripts\**\*.lua">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 页面 XAML：声明式界面定义，运行时由 PageLoader 用 XamlReader 解析。
         必须排除默认的 Page（BAML）编译，改为原样复制到输出目录的 Pages\ 下。 -->
    <Page Remove="Pages\**\*.xaml" />
    <Content Include="Pages\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- SECS/GEM（HSMS-SS）通讯：免费开源库，MIT 许可 -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="NLua" Version="1.7.9" />
    <PackageReference Include="Secs4Net" Version="3.1.0" />
    <!-- 测试机通讯（测试接口）：RS232 串口，.NET 8 起 SerialPort 需显式引用此包 -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

</Project>