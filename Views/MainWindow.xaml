<!-- ============================================================================
     Views/MainWindow.xaml — 主窗口布局（苹果风格外壳）
     项目：HandlerGuide（EXCEED9000 控制软件界面复刻）
     职责：顶栏（交通灯/标题/用户等级/说明书/关于）
           + 命令中心工具条 + 页面主体（固定标题 + 滚动内容）+ 底部实时状态条。
     ============================================================================ -->
<Window x:Class="HandlerGuide.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WenQiZhiTitle}"
        Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource WinBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部苹果风格标题栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Width="13" Height="13" Background="#FF5F57" BorderThickness="0" Cursor="Hand"
                            ToolTip="关闭程序" Command="{Binding CloseCommand}">
                        <Button.Template>
                            <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="7" /></ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="13" Height="13" Margin="8,0,0,0" Background="#FEBC2E" BorderThickness="0" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="7" /></ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="13" Height="13" Margin="8,0,0,0" Background="#28C840" BorderThickness="0" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="7" /></ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding TitleText}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ComboBox Width="110" FontSize="13" Margin="0,0,10,0"
                              ItemsSource="{Binding UserLevels}"
                              SelectedItem="{Binding SelectedUserLevel, Mode=TwoWay}" />
                    <Button Style="{StaticResource MenuButton}" Content="说明书" Command="{Binding ManualCommand}" Margin="0,0,4,0" />
                    <Button Style="{StaticResource MenuButton}" Content="关于" Command="{Binding AboutCommand}" Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 命令中心工具条 ================= -->
        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- JHT Logo -->
                    <Border Width="52" Height="42" CornerRadius="8" Background="#9B1B1B" Margin="0,0,8,0"
                            Cursor="Hand" ToolTip="主界面">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoHomeCommand}" />
                        </Border.InputBindings>
                        <TextBlock Text="JHT" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- 主界面 -->
                    <Button Style="{StaticResource ToolButton}" Command="{Binding GoHomeCommand}" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏠" FontSize="17" Margin="0,0,7,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="主界面" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- 命令中心（生产控制）已搬到「主界面」页内，见 HomePages.CommandCenter() -->
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,4" />

                    <!-- 模块按钮（含下拉子工具） -->
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="tb" IsChecked="{Binding IsOpen, Mode=TwoWay}"
                                                  Command="{Binding Command}" Cursor="Hand" Margin="2,0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="9"
                                                        Padding="10,5" BorderThickness="1" BorderBrush="Transparent"
                                                        TextElement.Foreground="{StaticResource TextPrimaryBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#E8F1FF" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="bd" Property="TextElement.Foreground" Value="White" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsGroupActive}" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="bd" Property="TextElement.Foreground" Value="White" />
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="17" Margin="0,0,7,0"
                                                       VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Line1}" FontSize="11.5" />
                                                <TextBlock Text="{Binding Line2}" FontSize="11.5"
                                                           Visibility="{Binding HasLine2, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
                                           PlacementTarget="{Binding ElementName=tb}"
                                           Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                                        <Border Background="{StaticResource CardBgBrush}"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                CornerRadius="12" Padding="6" MinWidth="230" Margin="8">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="12,8,12,4" />
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource DropItem}"
                                                                    Command="{Binding OpenCommand}">
                                                                <TextBlock>
                                                                    <Run Text="{Binding Icon, Mode=OneWay}" />
                                                                    <Run Text="   " />
                                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,4" />

                    <!-- 右侧快捷操作 -->
                    <Button Style="{StaticResource MiniButton}" Content="保存" Padding="18,6"
                            Command="{Binding SaveCommand}" />
                    <Button Style="{StaticResource MiniButton}" Content="召回" Padding="18,6"
                            Command="{Binding RecallCommand}" />

                    <!-- 显示控制板 --><!--
                    <ToggleButton x:Name="boardBtn" Cursor="Hand" Margin="2,0"
                                  IsChecked="{Binding BoardGroup.IsOpen, Mode=TwoWay}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="10,5"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E8F1FF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding BoardGroup.IsOpen}" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#DCE9FB" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🖥️" FontSize="17" Margin="0,0,7,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="显示" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="控制板" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ToggleButton>-->
                    <!--<Popup IsOpen="{Binding BoardGroup.IsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=boardBtn}"
                           Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="6" MinWidth="210" Margin="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
                            </Border.Effect>
                            <ItemsControl ItemsSource="{Binding BoardGroup.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DropItem}" Command="{Binding OpenCommand}"
                                                Content="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>-->

                    <CheckBox Content="键盘锁定" FontSize="12.5" VerticalAlignment="Center"
                              Margin="10,0,10,0" Foreground="{StaticResource TextPrimaryBrush}"
                              IsChecked="{Binding KeyboardLocked, Mode=TwoWay}" />

                    <ComboBox Width="92" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />

                    <Button Content="关闭程序" FontSize="12.5" Padding="18,8" Background="#9B1B1B"
                            Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CloseCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= 版本条 ================= -->
        <Border Grid.Row="2" Background="#E7F3E9"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="{Binding VersionText}" FontSize="11.5" Foreground="#1E6B32"
                           VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
        </Border>

        <!-- ================= 页面主体 ================= -->
        <Grid Grid.Row="3" Margin="12,10,12,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding PageTitle}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="{Binding PageDesc}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" />
            <ScrollViewer Grid.Row="2" x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                <ContentControl Content="{Binding CurrentContent}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <!--  固定屏页面（如主界面）填满视口，使底部条真正贴底  -->
                                <DataTrigger Binding="{Binding CurrentPage.Fill}" Value="True">
                                    <Setter Property="MinHeight"
                                            Value="{Binding ViewportHeight, ElementName=PageScroll, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= 底部状态条 ================= -->
        <Border Grid.Row="4" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Ellipse Width="9" Height="9" Fill="{Binding StatusDot}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding StatusRun}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusMode}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusRecipe}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusTemp}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusPressure}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusTempActual}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusServo}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusHome}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding Breadcrumb}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
                <TextBlock Text="{Binding StatusClock}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="|" Foreground="#C7C7CC" Margin="12,0" />
            </StackPanel>
        </Border>
    </Grid>
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</Window>
