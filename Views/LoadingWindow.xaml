<Window x:Class="HandlerGuide.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在启动 HandlerGuide"
        Width="460" Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#1E1E1E" Loaded="OnLoaded">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="HandlerGuide" FontSize="26" FontWeight="Bold"
                   Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="EXCEED9000 高速分选机控制软件" FontSize="13"
                   Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,18,0,0">
            <Border x:Name="Track" Height="10" Background="#3A3A3C" CornerRadius="5">
                <Border x:Name="BarFill" Height="10" Background="#34C759" CornerRadius="5"
                        HorizontalAlignment="Left" Width="0"/>
            </Border>
            <TextBlock x:Name="Status" Text="正在启动…" FontSize="13" Foreground="#D0D0D0"
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="温启志 编写 · 参数自动保存" FontSize="11" Foreground="#6A6A6A"
                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
    </Grid>
</Window>
