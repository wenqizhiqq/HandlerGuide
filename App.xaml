<!-- ============================================================================
     App.xaml — 应用程序定义（WPF 入口）
     项目：HandlerGuide（EXCEED9000 高速分选机控制软件界面复刻 · 苹果风格）
     职责：指定启动窗口 MainWindow，合并 AppleStyles / Elements 等资源字典。
     ============================================================================ -->
<Application x:Class="HandlerGuide.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/AppleStyles.xaml" />
                <ResourceDictionary Source="Views/Elements.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</Application>
