                <vm:GridChild Col="0" Row="1"><vw:Cell Text="预热盘 #1" Height="26" Ta="Left" Pad="4,1,4,1" /></vm:GridChild>
                <vm:GridChild Col="1" Row="1"><vw:Cell Height="26"><vw:Num Key="mt_off_0" Default="0" Width="104" Compact="True" /></vw:Cell></vm:GridChild>
                <vm:GridChild Col="2" Row="1"><vw:Cell Height="26"><vw:Live Signal="TempSet" Format="0.0" Width="104" Bg="BandGreyBrush" Fg="TextPrimaryBrush" FontSize="11.5" /></vw:Cell></vm:GridChild>

