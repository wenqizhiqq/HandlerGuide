<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

    <vm:TextElement Text="温度偏移值校准参数：设定高温模式下各个目标区域的温度偏差值。当目标温度比设定温度低时，设定值为正值，否则为负值。如目标区域实际测定值为 80 度而设定值为 95 度，则在该区域的偏移值处输入 +15。"
                    FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    <vm:SpacerElement H="10" />

    <vm:GroupElement Title="校准方式">
        <vw:Radios Key="mt_mode" OptionsText="1点|2点|3点" />
        <vm:SpacerElement H="6" />
        <vm:TextElement Text="1点：温度控制器在加热模式时对温度的校准只使用基点#3的偏移值。&#x0a;2点：根据基点#1和基点#3的偏移值计算目标温度偏移值。&#x0a;3点：分为 2 个范围，目标温度小于基点#2时根据基点#1和#2计算，大于基点#2时根据基点#2和#3计算。"
                        FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    </vm:GroupElement>

    <vm:GroupElement Title="基点设定（要求 基点#1 &lt; 基点#2 &lt; 基点#3）">
        <vm:GridElement ColsSpec="210,210,210" RowsSpec="Auto,Auto">
            <vm:GridChild Col="0" Row="0">
                <vm:FieldRowElement Label="基点#1" LabelWidth="92">
                    <vw:Num Key="mt_b1" Default="25" Width="96" />
                </vm:FieldRowElement>
            </vm:GridChild>
            <vm:GridChild Col="1" Row="0">
                <vm:FieldRowElement Label="基点#2" LabelWidth="92">
                    <vw:Num Key="mt_b2" Default="60" Width="96" />
                </vm:FieldRowElement>
            </vm:GridChild>
            <vm:GridChild Col="2" Row="0">
                <vm:FieldRowElement Label="基点#3" LabelWidth="92">
                    <vw:Num Key="mt_b3" Default="95" Width="96" />
                </vm:FieldRowElement>
            </vm:GridChild>
            <vm:GridChild Col="0" Row="1">
                <vm:FieldRowElement Label="基点#4" LabelWidth="92">
                    <vw:Num Key="mt_b4" Default="125" Width="96" />
                </vm:FieldRowElement>
            </vm:GridChild>
        </vm:GridElement>
    </vm:GroupElement>

