<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

  <!-- 温启志 18719361399 · 用户管理（纯声明式 XAML；权限表内联，用户列表以 vw:D 引用数据驱动生成器） -->
  <vm:GroupElement Title="用户管理">
    <!-- 用户列表：8 行 × 3 列实时用户数据（UserCell），行数固定但逐格实时刷新，保留生成器 -->
    <vm:ScrollElement ViewHeight="170" HScroll="Auto" VScroll="Auto">
      <vw:D Method="MaintUserGrid" />
    </vm:ScrollElement>
    <vm:SpacerElement H="6" />
    <vm:StackElement Orientation="Horizontal">
      <vw:TextInput Key="mu_user" Def="" Width="150" />
      <vw:TextInput Key="mu_pass" Def="" Width="150" />
      <vw:Cmb Key="mu_level" OptionsText="Operator|Engineer|Technician|Administrator" Width="130" Default="0" />
      <vw:MiniBtn Text="删除" Cmd="DeleteUser" />
      <vw:MiniBtn Text="修改" Cmd="AddOrUpdateUser" />
      <vw:MiniBtn Text="导出" Cmd="Export" Arg="user" />
      <vw:MiniBtn Text="导入" Cmd="Import" Arg="user" />
    </vm:StackElement>
  </vm:GroupElement>

  <vm:GroupElement Title="权限管理">
    <vm:ScrollElement ViewHeight="300" HScroll="Disabled" VScroll="Auto">
      <vm:GridElement ColsSpec="110,130,300,160" RowsSpec="Auto">
        <vm:GridChild Row="0" Col="0"><vw:Cell Text="Serial Number" Bg="#CFE3FB" Bold="True" Height="26" /></vm:GridChild>
        <vm:GridChild Row="0" Col="1"><vw:Cell Text="Identity Number" Bg="#CFE3FB" Bold="True" Height="26" /></vm:GridChild>
        <vm:GridChild Row="0" Col="2"><vw:Cell Text="Privilege Description" Bg="#CFE3FB" Bold="True" Height="26" /></vm:GridChild>
        <vm:GridChild Row="0" Col="3"><vw:Cell Text="Level Set" Bg="#CFE3FB" Bold="True" Height="26" /></vm:GridChild>

        <vm:GridChild Row="1" Col="0"><vw:Cell Text="0" Height="24" /></vm:GridChild>
        <vm:GridChild Row="1" Col="1"><vw:Cell Text="20" Height="24" /></vm:GridChild>
        <vm:GridChild Row="1" Col="2"><vw:Cell Text="品种设定" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="1" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_0" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="2" Col="0"><vw:Cell Text="1" Height="24" /></vm:GridChild>
        <vm:GridChild Row="2" Col="1"><vw:Cell Text="21" Height="24" /></vm:GridChild>
        <vm:GridChild Row="2" Col="2"><vw:Cell Text="单元设定" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="2" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_1" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="3" Col="0"><vw:Cell Text="2" Height="24" /></vm:GridChild>
        <vm:GridChild Row="3" Col="1"><vw:Cell Text="22" Height="24" /></vm:GridChild>
        <vm:GridChild Row="3" Col="2"><vw:Cell Text="诊断" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="3" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_2" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="0" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="4" Col="0"><vw:Cell Text="3" Height="24" /></vm:GridChild>
        <vm:GridChild Row="4" Col="1"><vw:Cell Text="23" Height="24" /></vm:GridChild>
        <vm:GridChild Row="4" Col="2"><vw:Cell Text="维护配置" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="4" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_3" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="5" Col="0"><vw:Cell Text="4" Height="24" /></vm:GridChild>
        <vm:GridChild Row="5" Col="1"><vw:Cell Text="24" Height="24" /></vm:GridChild>
        <vm:GridChild Row="5" Col="2"><vw:Cell Text="运行模式" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="5" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_4" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="6" Col="0"><vw:Cell Text="5" Height="24" /></vm:GridChild>
        <vm:GridChild Row="6" Col="1"><vw:Cell Text="28" Height="24" /></vm:GridChild>
        <vm:GridChild Row="6" Col="2"><vw:Cell Text="使能设定" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="6" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_5" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="0" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="7" Col="0"><vw:Cell Text="6" Height="24" /></vm:GridChild>
        <vm:GridChild Row="7" Col="1"><vw:Cell Text="25" Height="24" /></vm:GridChild>
        <vm:GridChild Row="7" Col="2"><vw:Cell Text="温控模式" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="7" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_6" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="0" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="8" Col="0"><vw:Cell Text="7" Height="24" /></vm:GridChild>
        <vm:GridChild Row="8" Col="1"><vw:Cell Text="26" Height="24" /></vm:GridChild>
        <vm:GridChild Row="8" Col="2"><vw:Cell Text="电机归零" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="8" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_7" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="9" Col="0"><vw:Cell Text="8" Height="24" /></vm:GridChild>
        <vm:GridChild Row="9" Col="1"><vw:Cell Text="29" Height="24" /></vm:GridChild>
        <vm:GridChild Row="9" Col="2"><vw:Cell Text="信息记录" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="9" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_8" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="10" Col="0"><vw:Cell Text="9" Height="24" /></vm:GridChild>
        <vm:GridChild Row="10" Col="1"><vw:Cell Text="32" Height="24" /></vm:GridChild>
        <vm:GridChild Row="10" Col="2"><vw:Cell Text="设定语言" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="10" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_9" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="0" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="11" Col="0"><vw:Cell Text="10" Height="24" /></vm:GridChild>
        <vm:GridChild Row="11" Col="1"><vw:Cell Text="27" Height="24" /></vm:GridChild>
        <vm:GridChild Row="11" Col="2"><vw:Cell Text="关闭程序" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="11" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_10" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>

        <vm:GridChild Row="12" Col="0"><vw:Cell Text="11" Height="24" /></vm:GridChild>
        <vm:GridChild Row="12" Col="1"><vw:Cell Text="140" Height="24" /></vm:GridChild>
        <vm:GridChild Row="12" Col="2"><vw:Cell Text="删除IC" Ta="Left" Height="24" /></vm:GridChild>
        <vm:GridChild Row="12" Col="3"><vw:Cell Height="24"><vw:Cmb Key="mu_lv_11" OptionsText="Operator|Engineer|Technician|Administrator" Width="150" Default="2" /></vw:Cell></vm:GridChild>
      </vm:GridElement>
    </vm:ScrollElement>
    <vm:SpacerElement H="6" />
    <vm:StackElement Orientation="Horizontal">
      <vw:Cmb Key="mu_priv_level" OptionsText="Operator|Engineer|Technician|Administrator" Width="130" Default="0" />
      <vw:MiniBtn Text="设定" Cmd="SetPrivilegeLevel" />
    </vm:StackElement>
    <vm:SpacerElement H="4" />
    <vm:StackElement Orientation="Horizontal">
      <vw:MiniBtn Text="导出" Cmd="Export" Arg="user" />
      <vw:MiniBtn Text="导入" Cmd="Import" Arg="user" />
    </vm:StackElement>
  </vm:GroupElement>

  <vm:StackElement Orientation="Horizontal">
    <vw:MiniBtn Text="恢复" Cmd="Reset" Arg="maint_user" />
    <vw:Btn Text="应用" Cmd="ApplyUsers" />
  </vm:StackElement>

  <vm:GroupElement Title="说明">
    <vm:TextElement Text="该窗口用于对本机用户进行维护。用户 “Administrator” 和 “Engineer” 为内置用户，无法被删除；只有 “Administrator” 可进入此界面。&#x0a;添加用户：在“用户名”和“口令”文本框中输入信息后点击[修改]按钮即可添加新用户，用户名不分大小写，不可与内置用户名相同，前后空字符会被自动截断去除。&#x0a;删除用户 / 更改信息：在列表中选择欲操作对象后操作。导入 / 导出：支持导出和导入用户管理及权限管理文件。" FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
  </vm:GroupElement>

  <vw:Watermark />
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</vm:StackElement>
