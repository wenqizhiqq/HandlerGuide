<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

    <vm:StackElement Orientation="Horizontal">
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="Fix1 | 0" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="20" Cols="8" Cw="15" Ch="15" />
        </vm:StackElement>
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="Fix2 | 0" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="20" Cols="8" Cw="15" Ch="15" />
        </vm:StackElement>
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="Fix3 | 0" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="20" Cols="8" Cw="15" Ch="15" />
        </vm:StackElement>
    </vm:StackElement>

    <vm:StackElement Orientation="Horizontal">
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="Auto1 | 0" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
