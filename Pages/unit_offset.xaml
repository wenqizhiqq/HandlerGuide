<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

    <vm:TextElement Text="偏移设定" FontSize="13" Foreground="#1D1D1F" FontWeight="SemiBold" />
    <vm:SpacerElement H="6" />
    <vm:TextElement Text="本模块定义了上下料取放臂在各个区域取放料的位置偏移参数，用户可根据具体实际取放的位置调整取放臂各个吸头在各个区域的取放偏移值。"
                    FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    <vm:TextElement Text="缺省值：X-(0), Y-(0), 单独设定-(否), 放料-(-2), 取料-(0), 吸头间距-(0)"
                    FontSize="11" Foreground="#6E6E73" Wrap="Wrap" />
    <vm:SpacerElement H="10" />

    <vm:GridElement ColsSpec="*,24,*">
        <vm:GridChild Col="0" Row="0">
            <vm:GroupElement Title="机台分区与吸头偏移">
                <vm:GridElement ColsSpec="*,1,*" RowsSpec="Auto,Auto">
                    <vm:GridChild Col="0" Row="0">
                        <vw:D Method="MachineMap" />
                    </vm:GridChild>
                    <vm:GridChild Col="1" Row="0">
                        <vm:BoxElement Background="#C0202A" BorderThickness="0" Width="1" Height="400" />
                    </vm:GridChild>
                    <vm:GridChild Col="2" Row="0">
                        <vw:ArmHead Title="吸头偏移">
                            <vm:FieldRowElement Label="X" LabelWidth="90" Unit="mm">
                                <vw:Num Key="uo_x" Default="0" Width="90" Format="0.###" />
                            </vm:FieldRowElement>
                            <vm:FieldRowElement Label="Y" LabelWidth="90" Unit="mm">
                                <vw:Num Key="uo_y" Default="0" Width="90" Format="0.###" />
                            </vm:FieldRowElement>
                            <vm:FieldRowElement Label="放料" LabelWidth="90" Unit="mm">
                                <vw:Num Key="uo_place" Default="-2" Width="90" Format="0.###" />
                            </vm:FieldRowElement>
                            <vm:FieldRowElement Label="吸料" LabelWidth="90" Unit="mm">
                                <vw:Num Key="uo_pick" Default="0" Width="90" Format="0.###" />
                            </vm:FieldRowElement>
                            <vm:FieldRowElement Label="吸头间距" LabelWidth="90" Unit="mm">
                                <vw:Num Key="uo_pitch" Default="0" Width="90" Format="0.###" />
                            </vm:FieldRowElement>
                            <vw:Chk Key="uo_single" Label="单独设定（可分别单独设定每个吸头）" />
                        </vw:ArmHead>
                    </vm:GridChild>
                    <vm:GridChild Col="0" Row="1">
                        <vm:GroupElement Title="区域选择">
                            <vm:ScrollElement ViewHeight="300">
                                <vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#1-小车A入口" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="1" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#2-小车B入口" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="2" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#3-上料盘" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="3" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#4-加热盘1" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="4" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#5-加热盘2" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="5" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#6-旋转台" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="6" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#7-清洁盘" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="7" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#8-自动盘1" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="8" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#9-自动盘2" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="9" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#10-自动盘3" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="10" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#11-固定盘1" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="11" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#12-固定盘2" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="12" />
                                    </vm:StackElement>
                                    <vm:StackElement Orientation="Horizontal">
                                        <vm:TextElement Text="#13-固定盘3" FontSize="12" Foreground="#1D1D1F" Width="150" Margin="0,0,6,0" />
                                        <vw:MiniBtn Text="+" Width="34" Cmd="OffsetRegion" Arg="13" />
                                    </vm:StackElement>
                                </vm:StackElement>
                            </vm:ScrollElement>
                        </vm:GroupElement>
                    </vm:GridChild>
                </vm:GridElement>
            </vm:GroupElement>
        </vm:GridChild>

        <vm:GridChild Col="2" Row="0">
            <vm:GroupElement Title="专项偏移">
                <vm:TextElement Text="小车A/B：分别设定测试运料小车在入口位和出口位的偏移，调整量为 -2~2mm"
                                FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
                <vm:FieldRowElement Label="小车A 入口" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_ca_in" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="小车A 出口" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_ca_out" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="小车B 入口" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_cb_in" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="小车B 出口" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_cb_out" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:SpacerElement H="6" />
                <vm:TextElement Text="空盘取放臂：调整空盘取放臂到六个自动进出盘机构的取放位置偏移"
                                FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
                <vm:MatrixElement CellWidth="110" CellHeight="26" RowHeadWidth="80" ColHeadHeight="24">
                    <vm:MatrixElement.Header>
                        <vw:Cell Text="" Bg="HeadBlueBrush" Bold="True" Width="80" Height="24" />
                        <vw:Cell Text="Auto1" Bg="HeadBlueBrush" Bold="True" Width="110" Height="24" />
                        <vw:Cell Text="Auto2" Bg="HeadBlueBrush" Bold="True" Width="110" Height="24" />
                        <vw:Cell Text="Auto3" Bg="HeadBlueBrush" Bold="True" Width="110" Height="24" />
                    </vm:MatrixElement.Header>
                    <vm:MatrixElement.Rows>
                        <vm:MatrixRow>
                            <vm:MatrixRow.Head>
                                <vw:Cell Text="偏移" Bg="HeadBlueBrush" Bold="True" Width="80" Height="26" />
                            </vm:MatrixRow.Head>
                            <vm:MatrixRow.Cells>
                                <vw:Num Key="uo_emp_0" Default="0" Width="110" Height="26" Format="0.###" Compact="True" />
                                <vw:Num Key="uo_emp_1" Default="0" Width="110" Height="26" Format="0.###" Compact="True" />
                                <vw:Num Key="uo_emp_2" Default="0" Width="110" Height="26" Format="0.###" Compact="True" />
                            </vm:MatrixRow.Cells>
                        </vm:MatrixRow>
                    </vm:MatrixElement.Rows>
                </vm:MatrixElement>
                <vm:SpacerElement H="6" />
                <vm:TextElement Text="测试Y：分别设定测试 Y 轴在取/放料位置的偏移，调整量为 -2~2mm"
                                FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
                <vm:FieldRowElement Label="测试Y 取料" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_ty_pick" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="测试Y 放料" LabelWidth="110" Unit="mm">
                    <vw:Num Key="uo_ty_place" Default="0" Width="90" Format="0.###" />
                </vm:FieldRowElement>
                <vm:SpacerElement H="6" />
                <vw:Chk Key="uo_rot_sep" Label="旋转台取/放分别设定" />
            </vm:GroupElement>
        </vm:GridChild>
    </vm:GridElement>

    <vm:StackElement Orientation="Horizontal">
        <vw:MiniBtn Text="恢复" Cmd="Reset" Arg="unit_offset" />
        <vw:Btn Text="应用" Cmd="Apply" Arg="unit_offset" />
    </vm:StackElement>

    <vw:Watermark />
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</vm:StackElement>
