<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">
    <vm:TextElement Text="温控模式" FontSize="13" Foreground="#1D1D1F" FontWeight="SemiBold" />
    <vm:SpacerElement H="8" />
    <vm:GroupElement Title="加热器工作条件">
        <vw:Radios Key="tc_mode" OptionsText="室温(25°C)|高温(50°C)" />
        <vm:SpacerElement H="10" />
        <vw:MiniBtn Text="恢复" Cmd="Reset" Arg="tempctl" />
        <vw:Btn Text="应用" Cmd="Apply" Arg="tempctl" />
    </vm:GroupElement>
    <vm:GroupElement Title="说明">
        <vm:TextElement Text="该窗口用于选择加热器的工作条件。选择“高温”后，主界面 Temp 区域会显示高温模式与温度范围。" FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    </vm:GroupElement>
    <vw:Watermark />
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</vm:StackElement>
