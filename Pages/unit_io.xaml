<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

    <vm:GridElement ColsSpec="*,24,*">
        <vm:GridChild Col="0" Row="0">
            <vm:GroupElement Title="检测与超时">
                <vm:FieldRowElement Label="料盘存在检查时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_exist" Default="300" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="料盘进出传送超时" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_moveto" Default="5000" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="料盘进出到位确认" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_arrive" Default="200" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="料盘进出接近确认" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_near" Default="100" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="顶盘气缸到位超时时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_cylto" Default="1000" Width="100" Format="0" />
                </vm:FieldRowElement>
            </vm:GroupElement>
        </vm:GridChild>

        <vm:GridChild Col="2" Row="0">
            <vm:GroupElement Title="气缸动作">
                <vm:FieldRowElement Label="料盘锁定时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_lock" Default="200" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="分盘气缸动作时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_split" Default="200" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="料盘敲击次数" LabelWidth="160" Unit="次">
                    <vw:Num Key="ui_knockn" Default="0" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="料盘敲击时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_knockt" Default="0" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="预温盘敲击次数" LabelWidth="160" Unit="次">
                    <vw:Num Key="ui_preknockn" Default="0" Width="100" Format="0" />
                </vm:FieldRowElement>
                <vm:FieldRowElement Label="预温盘敲击时间" LabelWidth="160" Unit="ms">
                    <vw:Num Key="ui_preknockt" Default="0" Width="100" Format="0" />
                </vm:FieldRowElement>
            </vm:GroupElement>
        </vm:GridChild>
    </vm:GridElement>

    <vm:GroupElement Title="其他">
        <vw:Chk Key="ui_float" Label="芯片浮动检查（激活 AUTO1/2/3 的浮动检查功能）" Default="True" />
        <vm:FieldRowElement Label="手自动换盘" LabelWidth="100">
            <vw:Cmb Key="ui_changemode" OptionsText="自动|手动" Width="130" />
        </vm:FieldRowElement>
    </vm:GroupElement>

    <vm:StackElement Orientation="Horizontal">
        <vw:MiniBtn Text="恢复" Cmd="Reset" Arg="unit_io" />
        <vw:Btn Text="应用" Cmd="Apply" Arg="unit_io" />
    </vm:StackElement>

    <vw:Watermark />
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</vm:StackElement>
