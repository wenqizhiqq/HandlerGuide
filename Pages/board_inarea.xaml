<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">

    <vm:StackElement Orientation="Horizontal">
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="Loader | 0" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="20" Cols="8" Cw="15" Ch="15" />
        </vm:StackElement>
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="CleanPlate" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="2" Cols="1" Cw="26" Ch="26" />
        </vm:StackElement>
        <vm:StackElement Margin="0,0,20,12">
            <vm:TextElement Text="" FontSize="12.5" Foreground="#1D1D1F" FontWeight="SemiBold" Align="Center" HAlign="Center" />
            <vw:CellGrid Rows="4" Cols="4" Cw="26" Ch="26" />
        </vm:StackElement>
    </vm:StackElement>

    <vm:GroupElement Title="图例">
        <vm:TextElement Text="单元格为灰底无字表示该位置没有料；单元格为蓝底 NT 表示入料托盘中有料；CleanPlate 盘为白底、CP 字样表示该位置有清洁片。"
                        FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    </vm:GroupElement>

    <vw:Watermark />
