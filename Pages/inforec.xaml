<vm:StackElement xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="clr-namespace:HandlerGuide.ViewModels;assembly=HandlerGuide"
                 xmlns:vw="clr-namespace:HandlerGuide.Views;assembly=HandlerGuide">
    <vm:TextElement Text="信息历史记录" FontSize="13" Foreground="#1D1D1F" FontWeight="SemiBold" />
    <vm:SpacerElement H="8" />
    <vm:GroupElement Title="查询条件">
        <vm:StackElement Orientation="Horizontal">
            <vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="开始日期" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:TextInput Key="il_from" Def="" Width="130" />
                </vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="结束日期" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:TextInput Key="il_to" Def="" Width="130" />
                </vm:StackElement>
            </vm:StackElement>
            <vm:SpacerElement W="30" />
            <vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="类型" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:Cmb Key="il_type" OptionsText="Dummy|Machine|System|HMI_Main" Width="120" />
                </vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="单元" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:Cmb Key="il_unit" OptionsText="全部|上料臂|下料臂" Width="120" />
                </vm:StackElement>
            </vm:StackElement>
            <vm:SpacerElement W="20" />
            <vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="子模块" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:Cmb Key="il_sub" OptionsText="全部|Shuttle" Width="120" />
                </vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="运行模式" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:Cmb Key="il_run" OptionsText="Normal|Exercise|Dry1|Dry2" Width="120" />
                </vm:StackElement>
            </vm:StackElement>
            <vm:SpacerElement W="20" />
            <vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vm:TextElement Text="代码" FontSize="12" Foreground="#1D1D1F" Margin="0,0,8,0" />
                    <vw:TextInput Key="il_code" Def="" Width="120" />
                </vm:StackElement>
                <vm:StackElement Orientation="Horizontal">
                    <vw:MiniBtn Text="更新" Cmd="UpdateLog" />
                    <vw:MiniBtn Text="导出" Cmd="ExportLog" />
                </vm:StackElement>
            </vm:StackElement>
        </vm:StackElement>
    </vm:GroupElement>
    <vm:SpacerElement H="8" />
    <vm:ScrollElement Height="320">
        <vw:D Method="InfoLog" />
    </vm:ScrollElement>
    <vm:GroupElement Title="说明">
        <vm:TextElement Text="该窗口用于显示设备运行过程中的事件记录，事件记录在本机的 SQL 数据库中，可通过此界面进行查询，输入开始、结束时间，并可限定类型和单元，并可将查询结果导出为文本文件。" FontSize="11.5" Foreground="#6E6E73" Wrap="Wrap" />
    </vm:GroupElement>
    <vw:Watermark />
<!-- 温启志 18719361399 · 本文件由温启志（18719361399）编写；界面与源码水印均指向该作者。 -->
</vm:StackElement>
